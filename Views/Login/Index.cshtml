@model Absensiguru.Models.User

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 1. Perubahan Judul Tag Title -->
    <title>Login | SIMAGU</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
            background: linear-gradient(135deg,#d50000,#ff5252,#ffffff);
        }

        /* BACKGROUND */
        body::before {
            content: "";
            position: absolute;
            width: 650px;
            height: 650px;
            background: #ffffff;
            border-radius: 50%;
            left: -180px;
            top: -180px;
            opacity: .12;
            filter: blur(10px);
        }

        body::after {
            content: "";
            position: absolute;
            width: 550px;
            height: 550px;
            background: #ff1744;
            border-radius: 50%;
            right: -120px;
            bottom: -150px;
            opacity: .15;
            filter: blur(10px);
        }

        .circle1 {
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
            top: 120px;
            left: 120px;
        }

        .circle2 {
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.20);
            bottom: 80px;
            right: 120px;
        }

        .circle3 {
            position: absolute;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: white;
            opacity: .25;
            top: 80%;
            left: 15%;
        }

        .pattern {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.4) 1px, transparent 1px);
            background-size: 28px 28px;
            opacity: .18;
        }

        .wave {
            position: absolute;
            bottom: -60px;
            left: -100px;
            width: 140%;
            height: 250px;
            background: white;
            border-radius: 50%;
            transform: rotate(-6deg);
            opacity: .20;
        }

        .login-card {
            position: relative;
            z-index: 10;
            width: 430px;
            background: rgba(255,255,255,.95);
            border-radius: 25px;
            padding: 45px;
            box-shadow: 0 25px 60px rgba(0,0,0,.18);
            animation: fade .8s;
        }

        @@keyframes fade {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body>

    <!-- Background Abstract -->
    <div class="pattern"></div>
    <div class="circle1"></div>
    <div class="circle2"></div>
    <div class="circle3"></div>
    <div class="wave"></div>

    <!-- Login Card -->
    <div class="login-card">

        <div class="text-center mb-4">
            <img src="~/images/logo.png" alt="Logo Sekolah" style="width:90px; margin-bottom:15px;">

            <!-- 4. Perubahan Header Teks Judul Login -->
            <h2 class="fw-bold text-danger mb-1">SIMAGU</h2>
            <p class="text-secondary mb-0 fw-semibold" style="font-size: 15px;">
                Sistem Informasi Manajemen Absensi Guru
            </p>
            <p class="text-muted small mb-0 mt-1">
                SDN Emo Kurniaatmaja
            </p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center">
                @ViewBag.Error
            </div>
        }

        <form asp-action="Index" method="post">

            <div class="mb-3">
                <label class="form-label fw-semibold">Username</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="fa-solid fa-user text-danger"></i>
                    </span>
                    <input type="text"
                           name="username"
                           class="form-control"
                           placeholder="Masukkan Username"
                           required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="fa-solid fa-lock text-danger"></i>
                    </span>
                    <input type="password"
                           id="password"
                           name="password"
                           class="form-control"
                           placeholder="Masukkan Password"
                           required />
                    <button class="btn btn-outline-secondary" type="button" onclick="lihatPassword()">
                        <i id="iconPassword" class="fa-solid fa-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-bold">
                <i class="fa-solid fa-right-to-bracket me-1"></i> LOGIN
            </button>

        </form>

        <hr>

        <div class="text-center">
            <!-- Perubahan teks copyright di bawah form -->
            <small class="text-muted">
                © 2026 SIMAGU. All Rights Reserved.
            </small>
        </div>

    </div>

    <script>
        function lihatPassword() {
            var x = document.getElementById("password");
            var icon = document.getElementById("iconPassword");

            if (x.type === "password") {
                x.type = "text";
                icon.className = "fa-solid fa-eye-slash";
            } else {
                x.type = "password";
                icon.className = "fa-solid fa-eye";
            }
        }
    </script>

</body>
</html>