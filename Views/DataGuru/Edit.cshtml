@model Absensiguru.Models.Guru

@{
    ViewData["Title"] = "Edit Guru";
}

<div class="container py-4">

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-warning">

            <h3 class="fw-bold mb-0 text-dark">
                Edit Data Guru
            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <input type="hidden" asp-for="IdGuru" />

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Nama Guru
                        </label>

                        <input asp-for="NamaGuru"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            NIP
                        </label>

                        <input asp-for="Nip"
                               class="form-control" />

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Jenis Kelamin
                        </label>

                        <select asp-for="JenisKelamin"
                                class="form-select">

                            <option value="L">Laki-laki</option>
                            <option value="P">Perempuan</option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Jabatan
                        </label>

                        <select asp-for="IdJabatan"
                                class="form-select">

                            @foreach (var jabatan in ViewBag.Jabatan)
                            {
                                <option value="@jabatan.IdJabatan">
                                    @jabatan.NamaJabatan
                                </option>
                            }

                        </select>

                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Nomor HP
                    </label>

                    <input asp-for="NoHp"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Alamat
                    </label>

                    <textarea asp-for="Alamat"
                              rows="3"
                              class="form-control"></textarea>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="Aktif">
                            Aktif
                        </option>

                        <option value="Nonaktif">
                            Nonaktif
                        </option>

                    </select>

                </div>

                <hr />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-secondary rounded-pill px-4">

                        ← Kembali

                    </a>

                    <button class="btn btn-warning rounded-pill px-4">

                        💾 Simpan Perubahan

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>