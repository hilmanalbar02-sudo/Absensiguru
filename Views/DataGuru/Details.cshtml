@model Absensiguru.Models.Guru

@{
    ViewData["Title"] = "Detail Guru";
}

<div class="container py-4">

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-danger text-white">

            <h3 class="mb-0">
                Detail Data Guru
            </h3>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-3 text-center">

                    <img src="~/images/user.png"
                         class="img-fluid rounded-circle border shadow"
                         style="width:170px;height:170px;object-fit:cover;" />

                </div>

                <div class="col-md-9">

                    <table class="table table-borderless align-middle">

                        <tr>
                            <th width="220">Nama Guru</th>
                            <td>: @Model.NamaGuru</td>
                        </tr>

                        <tr>
                            <th>NIP</th>
                            <td>: @Model.Nip</td>
                        </tr>

                        <tr>
                            <th>Jenis Kelamin</th>
                            <td>: @(Model.JenisKelamin == "L" ? "Laki-laki" : "Perempuan")</td>
                        </tr>

                        <tr>
                            <th>Jabatan</th>
                            <td>: @Model.IdJabatanNavigation.NamaJabatan</td>
                        </tr>

                        <tr>
                            <th>Email</th>
                            <td>: @Model.Email</td>
                        </tr>

                        <tr>
                            <th>No HP</th>
                            <td>: @Model.NoHp</td>
                        </tr>

                        <tr>
                            <th>Alamat</th>
                            <td>: @Model.Alamat</td>
                        </tr>

                        <tr>
                            <th>Status</th>

                            <td>

                                @if (Model.Status == "Aktif")
                                {
                                    <span class="badge bg-success px-3 py-2">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2">
                                        Nonaktif
                                    </span>
                                }

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <div class="card-footer d-flex justify-content-between align-items-center">

            <a asp-action="Index"
               class="btn btn-secondary rounded-pill px-4">

                <i class="fa-solid fa-arrow-left me-1"></i>
                Kembali

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.IdGuru"
               class="btn btn-warning rounded-pill px-4">

                <i class="fa-solid fa-pen-to-square me-1"></i>
                Edit Data

            </a>

        </div>

    </div>

</div>