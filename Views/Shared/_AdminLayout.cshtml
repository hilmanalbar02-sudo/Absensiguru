@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Sistem Absensi Guru</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>

        body{
            margin:0;
            background:#f5f6fa;
            font-family:'Segoe UI',sans-serif;
        }

        .sidebar{
            position:fixed;
            left:0;
            top:0;
            width:260px;
            height:100vh;
            background:linear-gradient(180deg,#c40000,#ff2d2d);
            color:white;
            overflow:auto;
            box-shadow:0 0 20px rgba(0,0,0,.15);
        }

        .logo{
            text-align:center;
            padding:30px 20px;
            border-bottom:1px solid rgba(255,255,255,.15);
        }

        .logo img{
            width:80px;
            margin-bottom:15px;
        }

        .logo h5{
            margin:0;
            font-weight:bold;
        }

        .logo small{
            opacity:.9;
        }

        .menu{
            margin-top:20px;
        }

        .menu a{
            display:block;
            color:white;
            text-decoration:none;
            padding:15px 25px;
            transition:.3s;
            font-size:15px;
        }

        .menu a:hover{
            background:rgba(255,255,255,.15);
            padding-left:35px;
        }

        .menu a.active{
            background:rgba(255,255,255,.20);
            border-left:5px solid white;
        }

        .menu i{
            width:25px;
        }

        .content{
            margin-left:260px;
            min-height:100vh;
        }

        .topbar{
            background:white;
            padding:18px 30px;
            display:flex;
            justify-content:space-between;
            align-items:center;
            box-shadow:0 5px 15px rgba(0,0,0,.08);
        }

        .main-content{
            padding:30px;
        }

    </style>

</head>

<body>

    <div class="sidebar">

        <div class="logo">

            <img src="~/images/logo.png" alt="Logo" />

            <h5>ABSENSI GURU</h5>

            <small>SDN Emo Kurniaatmaja</small>

        </div>

        <div class="menu">

            <a asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>

            <a asp-controller="DataGuru" asp-action="Index">
                <i class="bi bi-people-fill"></i>
                Data Guru
            </a>

            <a asp-controller="DataUser" asp-action="Index">
                <i class="bi bi-person-circle"></i>
                Data User
            </a>

            <a asp-controller="DataAbsensi" asp-action="Index">
                <i class="bi bi-calendar-check-fill"></i>
                Data Absensi
            </a>

            <a asp-controller="DataIzin" asp-action="Index">
                <i class="bi bi-file-earmark-text-fill"></i>
                Data Izin
            </a>

            <a asp-controller="Laporan" asp-action="Index">
                <i class="bi bi-bar-chart-fill"></i>
                Laporan
            </a>

            <hr class="text-white"/>

            <a asp-controller="Login" asp-action="Logout">
                <i class="bi bi-box-arrow-right"></i>
                Logout
            </a>

        </div>

    </div>

    <div class="content">

        <div class="topbar">

            <div>
                <h4 class="mb-0 text-danger fw-bold">
                    @ViewData["Title"]
                </h4>
            </div>

            <div>

                <i class="bi bi-person-circle"></i>

                <strong>
                    @(Context.Session.GetString("NamaGuru") ??
                      Context.Session.GetString("Username"))
                </strong>

            </div>

        </div>

        <div class="main-content">

            @RenderBody()

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>