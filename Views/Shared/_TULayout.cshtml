@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Sistem Absensi Guru</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        body{
            margin:0;
            background:#edf2f7;
            font-family:'Segoe UI',sans-serif;
        }

        /* SIDEBAR BARU: LEBAR 360PX & MEMBULAT SISI KANAN */
        .sidebar{
            position:fixed;
            left:0;
            top:0;
            width:360px;
            height:100vh;
            overflow-y:auto;
            background:linear-gradient(180deg,#c40000,#ef1d1d);
            border-radius:0 35px 35px 0;
            color:white;
            box-shadow:8px 0 30px rgba(0,0,0,.18);
            z-index:999;
        }

        .logo{
            padding:35px 30px 25px 30px;
            text-align:center;
            border-bottom:1px solid rgba(255,255,255,.15);
        }

        .logo img{
            width:90px;
            height:90px;
            object-fit:contain;
            margin-bottom:15px;
        }

        .logo h5{
            margin:0;
            font-weight:bold;
            letter-spacing:0.5px;
        }

        .logo small{
            opacity:.8;
            display:block;
            margin-bottom:12px;
        }

        .menu{
            margin-top:20px;
            padding:0 15px;
        }

        .menu a{
            display:flex;
            align-items:center;
            gap:15px;
            color:white;
            text-decoration:none;
            padding:16px 22px;
            margin:8px 0;
            border-radius:18px;
            transition:.35s;
            font-weight:500;
        }

        .menu a:hover{
            background:rgba(255,255,255,.1);
            color:white;
            transform:translateX(8px);
        }

        /* MENU AKTIF PUTIH TEXT MERAH SESUAI GAMBAR BARU */
        .menu a.active{
            background:white;
            color:#e11d48;
            font-weight:600;
            box-shadow:0 10px 25px rgba(0,0,0,.15);
        }

        .menu i{
            font-size:22px;
            width:25px;
        }

        .content{
            margin-left:0;
            min-height:100vh;
            display:flex;
            flex-direction:column;
        }

        /* TOPBAR MELAYANG SEPERTI KARTU PUTIH */
        .topbar{
            margin:20px;
            margin-left:390px; /* Jarak aman dari sidebar (360px + 30px gap) */
            background:#fff;
            border-radius:25px;
            padding:25px 40px;
            display:flex;
            justify-content:space-between;
            align-items:center;
            box-shadow:0 10px 25px rgba(0,0,0,.06);
            position:sticky;
            top:20px;
            z-index:100;
        }

        .main-content{
            padding:15px 40px 40px 40px;
            margin-left:360px; /* Batas konten kiri sejajar lebar sidebar */
            flex:1;
        }

        .user-info{
            display:flex;
            align-items:center;
            gap:12px;
        }

        /* AVATAR BULAT FOTO (Bisa diganti tag img jika ada foto asli) */
        .user-avatar{
            width:45px;
            height:45px;
            border-radius:50%;
            background:#ffcbd1;
            display:flex;
            justify-content:center;
            align-items:center;
            color:#dc3545;
            font-size:22px;
            border:2px solid white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        hr{
            opacity:.15;
        }
    </style>
</head>

<body>

    <div class="sidebar">
        <div class="logo">
            <img src="~/images/logo.png" alt="Logo" />
            <h5>ABSENSI GURU</h5>
            <small>SDN Emo Kurniaatmaja</small>
            
            <!-- BADGE ADMINISTRATOR DI SIDEBAR SESUAI GAMBAR -->
            <span class="badge bg-white text-danger px-3 py-2 fw-bold rounded-pill shadow-sm d-inline-block" style="font-size: 11px; letter-spacing: 0.5px;">
                Administrator
            </span>
        </div>

        <div class="menu">
            
            <!-- PERBAIKAN ROUTING LOCK KE TU DASHBOARD -->
            <a asp-controller="TU" asp-action="Dashboard" class="@(ViewData["Title"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>

            <a asp-controller="DataGuru" asp-action="Index" class="@(ViewData["Title"]?.ToString() == "Data Guru" ? "active" : "")">
                <i class="bi bi-people-fill"></i>
                Data Guru
            </a>

            <a asp-controller="DataUser" asp-action="Index" class="@(ViewData["Title"]?.ToString() == "Data User" ? "active" : "")">
                <i class="bi bi-person-circle"></i>
                Data User
            </a>

            <a asp-controller="DataAbsensi" asp-action="Index" class="@(ViewData["Title"]?.ToString() == "Data Absensi" ? "active" : "")">
                <i class="bi bi-calendar-check-fill"></i>
                Data Absensi
            </a>

            <a asp-controller="DataIzin" asp-action="Index" class="@(ViewData["Title"]?.ToString() == "Data Izin" ? "active" : "")">
                <i class="bi bi-file-earmark-text-fill"></i>
                Data Izin
            </a>

            <a asp-controller="Laporan" asp-action="Index" class="@(ViewData["Title"]?.ToString() == "Laporan" ? "active" : "")">
                <i class="bi bi-bar-chart-fill"></i>
                Laporan
            </a>

            <hr class="text-white"/>

            <a asp-controller="TU" asp-action="AbsensiSaya" class="@(ViewData["Title"]?.ToString() == "Absen Saya" ? "active" : "")">
                <i class="bi bi-fingerprint"></i>
                Absen Saya
            </a>

            <a asp-controller="TU" asp-action="RiwayatSaya" class="@(ViewData["Title"]?.ToString() == "Riwayat Absensi" ? "active" : "")">
                <i class="bi bi-clock-history"></i>
                Riwayat Absensi
            </a>

            <a asp-controller="TU" asp-action="ProfilSaya" class="@(ViewData["Title"]?.ToString() == "Profil Saya" ? "active" : "")">
                <i class="bi bi-person-badge-fill"></i>
                Profil Saya
            </a>

            <hr class="text-white"/>

            <a asp-controller="Login" asp-action="Logout">
                <i class="bi bi-box-arrow-right"></i>
                Logout
            </a>

        </div>
    </div>

    <div class="content">
        <div class="topbar">
            <div>
                <h4 class="mb-0 text-danger fw-bold" style="font-size: 24px;">
                    @ViewData["Title"]
                </h4>
                <small class="text-muted d-block" style="font-size: 13px; margin-top: 2px;">
                    Selamat datang di Sistem Absensi Guru
                </small>
            </div>

            <div class="user-info">
                <div class="text-end">
                    <div class="fw-bold text-uppercase" style="color: #1e293b; font-size: 14px; letter-spacing: 0.3px;">
                        @(Context.Session.GetString("NamaGuru") ?? Context.Session.GetString("Username") ?? "AI ROKAYAH")
                    </div>
                    <small class="text-muted d-block" style="font-size: 12px; margin-top: -2px;">
                        Administrator
                    </small>
                </div>
                <div class="user-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
            </div>
        </div>

        <div class="main-content">
            @RenderBody()

            <hr class="mt-5" />
            <div class="text-center text-muted py-3" style="font-size: 13px;">
                © 2026 Sistem Absensi Guru
                <br />
                <span class="fw-semibold">SDN Emo Kurniaatmaja</span>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>