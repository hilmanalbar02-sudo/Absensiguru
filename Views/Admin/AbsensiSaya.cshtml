@model Absensiguru.Models.Guru

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Absen Saya";

    var absen = ViewBag.AbsensiHariIni as Absensiguru.Models.Absensi;
}

<div class="container-fluid">

    @if (TempData["Sukses"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sukses"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row">

        <div class="col-lg-4">

            <div class="card shadow border-0 rounded-4">

                <div class="card-body text-center">

                    @if (!string.IsNullOrEmpty(Model.Foto))
                    {
                        <img src="~/uploads/guru/@Model.Foto"
                             class="rounded-circle mb-3"
                             style="width:180px;height:180px;object-fit:cover;">
                    }
                    else
                    {
                        <img src="~/images/user.png"
                             class="rounded-circle mb-3"
                             style="width:180px;height:180px;object-fit:cover;">
                    }

                    <h3 class="fw-bold">@Model.NamaGuru</h3>

                    <p class="text-muted">
                        @Model.IdJabatanNavigation.NamaJabatan
                    </p>

                    <hr />

                    <h5>@DateTime.Now.ToString("dddd, dd MMMM yyyy")</h5>

                </div>

            </div>

        </div>

        <div class="col-lg-8">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header bg-danger text-white">

                    <h4 class="mb-0">
                        Absensi Hari Ini
                    </h4>

                </div>

                <div class="card-body">

                    @if (absen == null)
                    {
                        <h5 class="text-secondary mb-4">
                            Anda belum melakukan absensi hari ini.
                        </h5>

                        <form asp-action="AbsenMasuk" method="post">

                            <button class="btn btn-success btn-lg">
                                <i class="bi bi-box-arrow-in-right"></i>
                                Absen Masuk
                            </button>

                        </form>
                    }
                    else
                    {
                        <table class="table table-bordered">

                            <tr>
                                <th width="180">Tanggal</th>
                                <td>@absen.Tanggal</td>
                            </tr>

                            <tr>
                                <th>Jam Masuk</th>
                                <td>@absen.JamMasuk</td>
                            </tr>

                            <tr>
                                <th>Jam Pulang</th>
                                <td>
                                    @(absen.JamPulang == null ? "-" : absen.JamPulang)
                                </td>
                            </tr>

                            <tr>
                                <th>Status</th>
                                <td>@absen.Status</td>
                            </tr>

                        </table>

                        @if (absen.JamPulang == null)
                        {
                            <form asp-action="AbsenPulang" method="post">

                                <button class="btn btn-danger btn-lg">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Absen Pulang
                                </button>

                            </form>
                        }
                        else
                        {
                            <div class="alert alert-success">
                                Anda sudah menyelesaikan absensi hari ini.
                            </div>
                        }

                    }

                </div>

            </div>

        </div>

    </div>

</div>