@model Absensiguru.ViewModels.UbahPasswordViewModel

@{
    ViewData["Title"] = "Ubah Password";
}

<div class="container py-4">

    @if (TempData["Sukses"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Sukses"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow border-0">

        <div class="card-header bg-danger text-white">

            <h4 class="mb-0">
                <i class="bi bi-shield-lock-fill"></i>
                Ubah Password
            </h4>

        </div>

        <div class="card-body p-4">

            <form asp-action="UbahPassword" method="post">

                <input asp-for="IdGuru" type="hidden"/>

                <div class="mb-3">

                    <label class="form-label">
                        Password Lama
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input asp-for="PasswordLama"
                               type="password"
                               class="form-control"
                               id="passlama"/>

                        <button class="btn btn-outline-secondary"
                                type="button"
                                onclick="lihatPassword('passlama',this)">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="PasswordLama"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Password Baru
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-key-fill"></i>
                        </span>

                        <input asp-for="PasswordBaru"
                               type="password"
                               class="form-control"
                               id="passbaru"/>

                        <button class="btn btn-outline-secondary"
                                type="button"
                                onclick="lihatPassword('passbaru',this)">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="PasswordBaru"
                          class="text-danger"></span>

                </div>

                <div class="mb-4">

                    <label class="form-label">
                        Konfirmasi Password
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-check2-circle"></i>
                        </span>

                        <input asp-for="KonfirmasiPassword"
                               type="password"
                               class="form-control"
                               id="konfirmasi"/>

                        <button class="btn btn-outline-secondary"
                                type="button"
                                onclick="lihatPassword('konfirmasi',this)">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="KonfirmasiPassword"
                          class="text-danger"></span>

                </div>

                <button class="btn btn-danger">

                    <i class="bi bi-save"></i>

                    Simpan Password

                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts{

    <partial name="_ValidationScriptsPartial"/>

    <script>

        function lihatPassword(id,btn){

            var input=document.getElementById(id);

            var icon=btn.querySelector("i");

            if(input.type==="password"){

                input.type="text";

                icon.className="bi bi-eye-slash";

            }else{

                input.type="password";

                icon.className="bi bi-eye";

            }

        }

    </script>

}