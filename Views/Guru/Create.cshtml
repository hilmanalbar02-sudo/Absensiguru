@model Absensiguru.Models.Guru

@{
    ViewData["Title"] = "Tambah Guru";
}

<div class="container py-4">

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-danger text-white rounded-top-4">
            <h3 class="mb-0 fw-bold">
                Tambah Data Guru
            </h3>
        </div>

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="NamaGuru" class="form-label fw-bold"></label>
                    <input asp-for="NamaGuru" class="form-control" placeholder="Masukkan nama guru" />
                    <span asp-validation-for="NamaGuru" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Nip" class="form-label fw-bold"></label>
                    <input asp-for="Nip" class="form-control" placeholder="Masukkan NIP" />
                    <span asp-validation-for="Nip" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="JenisKelamin" class="form-label fw-bold">Jenis Kelamin</label>
                    <select asp-for="JenisKelamin" class="form-select">
                        <option value="">-- Pilih Jenis Kelamin --</option>
                        <option value="L">Laki-laki</option>
                        <option value="P">Perempuan</option>
                    </select>
                    <span asp-validation-for="JenisKelamin" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Alamat" class="form-label fw-bold"></label>
                    <textarea asp-for="Alamat"
                              class="form-control"
                              rows="3"
                              placeholder="Masukkan alamat"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <input asp-for="Email" class="form-control" placeholder="Masukkan email" />
                </div>

                <div class="mb-3">
                    <label asp-for="NoHp" class="form-label fw-bold">No HP</label>
                    <input asp-for="NoHp" class="form-control" placeholder="Masukkan nomor HP" />
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label fw-bold"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Aktif">Aktif</option>
                        <option value="Nonaktif">Nonaktif</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="IdJabatan" class="form-label fw-bold">Jabatan</label>

                    <select asp-for="IdJabatan" class="form-select">

                        <option value="">-- Pilih Jabatan --</option>

                        @foreach (var jabatan in ViewBag.Jabatan)
                        {
                            <option value="@jabatan.IdJabatan">
                                @jabatan.NamaJabatan
                            </option>
                        }

                    </select>

                    <span asp-validation-for="IdJabatan" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-secondary rounded-pill px-4">
                        Kembali
                    </a>

                    <button type="submit"
                            class="btn btn-danger rounded-pill px-4">
                        Simpan Guru
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}