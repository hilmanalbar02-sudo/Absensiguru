@model Absensiguru.ViewModels.IzinViewModel

@{
    ViewData["Title"] = "Pengajuan Izin";
}

<div class="row">

    <div class="col-lg-8 mx-auto">

        @if (TempData["Sukses"] != null)
        {
            <div class="alert alert-success">
                @TempData["Sukses"]
            </div>
        }

        <div class="card shadow border-0 rounded-4">

            <div class="card-header bg-danger text-white">

                <h3 class="mb-0">
                    <i class="bi bi-file-earmark-medical"></i>
                    Pengajuan Izin Guru
                </h3>

            </div>

            <div class="card-body">

                <form asp-action="PengajuanIzin"
                      method="post"
                      enctype="multipart/form-data">

                    <div class="mb-3">

                        <label class="form-label">
                            Tanggal
                        </label>

                        <input asp-for="Tanggal"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Jenis Izin
                        </label>

                        <select asp-for="JenisIzin"
                                class="form-select">

                            <option value="">-- Pilih --</option>

                            <option>Izin</option>

                            <option>Sakit</option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Alasan
                        </label>

                        <textarea asp-for="Alasan"
                                  rows="5"
                                  class="form-control"></textarea>

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Upload Bukti (Opsional)
                        </label>

                        <input asp-for="Bukti"
                               class="form-control"
                               type="file" />

                    </div>

                    <button class="btn btn-danger btn-lg">

                        <i class="bi bi-send-fill"></i>

                        Kirim Pengajuan

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>