@model Absensiguru.Models.Absensi

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Absensi";
}

<div class="card shadow border-0 rounded-4">

    <div class="card-header bg-warning text-dark">
        <h3>Edit Data Absensi</h3>
    </div>

    <div class="card-body">

        <form asp-action="Edit">

            <input type="hidden" asp-for="IdAbsensi"/>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="IdGuru" class="form-label"></label>

                <select asp-for="IdGuru"
                        asp-items="ViewBag.Guru"
                        class="form-select">
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Tanggal" class="form-label"></label>

                <input asp-for="Tanggal"
                       type="date"
                       class="form-control"/>
            </div>

            <div class="row">

                <div class="col-md-6">

                    <label asp-for="JamMasuk"></label>

                    <input asp-for="JamMasuk"
                           type="time"
                           class="form-control"/>

                </div>

                <div class="col-md-6">

                    <label asp-for="JamPulang"></label>

                    <input asp-for="JamPulang"
                           type="time"
                           class="form-control"/>

                </div>

            </div>

            <br/>

            <div class="mb-3">

                <label asp-for="Status"></label>

                <select asp-for="Status" class="form-select">

                    <option>Hadir</option>
                    <option>Izin</option>
                    <option>Sakit</option>
                    <option>Alpha</option>

                </select>

            </div>

            <div class="mb-3">

                <label asp-for="Keterangan"></label>

                <textarea asp-for="Keterangan"
                          class="form-control"></textarea>

            </div>

            <button class="btn btn-warning">
                Update
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Kembali
            </a>

        </form>

    </div>

</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}