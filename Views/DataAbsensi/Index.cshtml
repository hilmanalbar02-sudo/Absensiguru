@model IEnumerable<Absensiguru.Models.Absensi>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Data Absensi";

    int no = 1;
}

<div class="page-card shadow-sm border-0 rounded-4 bg-white p-4">

    <!-- LANGKAH 1: HEADER HALAMAN BARU -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-calendar-check-fill text-danger me-2"></i>
                Data Absensi Guru
            </h3>
            <p class="text-muted mb-0 small">
                Kelola seluruh data kehadiran guru SDN Emo Kurniaatmaja
            </p>
        </div>
    </div>

    <div class="card-body p-0">

        <!-- NOTIFIKASI SUKSES -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- LANGKAH 2: INPUT PENCARIAN REAL-TIME -->
        <div class="row mb-4">
            <div class="col-md-5">
                <div class="input-group shadow-sm rounded-3 overflow-hidden">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input id="searchGuru" 
                           type="text" 
                           class="form-control border-start-0 ps-0" 
                           placeholder="Cari Nama Guru..." style="border-radius: 0 8px 8px 0;" />
                </div>
            </div>
        </div>

        <!-- LANGKAH 3: STRUKTUR TABEL MODERN -->
        <div class="table-responsive">
            <table class="table table-modern align-middle table-hover">
                <thead>
                    <tr>
                        <th width="60" class="text-center">No</th>
                        <th width="80">Foto</th>
                        <th>Nama Guru</th>
                        <th width="130" class="text-center">Tanggal</th>
                        <th width="110" class="text-center">Jam Masuk</th>
                        <th width="110" class="text-center">Jam Pulang</th>
                        <th width="120" class="text-center">Status</th>
                        <th width="130" class="text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody id="tableGuru">
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-medium text-secondary">
                                    @(no++)
                                </td>

                                <!-- LANGKAH 4: FOTO GURU -->
                                <td>
                                    @if (!string.IsNullOrEmpty(item.IdGuruNavigation?.Foto))
                                    {
                                        <img src="~/uploads/guru/@item.IdGuruNavigation.Foto" 
                                             width="50" 
                                             height="50" 
                                             class="rounded-circle shadow-sm object-fit-cover border" 
                                             alt="Foto @item.IdGuruNavigation.NamaGuru">
                                    }
                                    else
                                    {
                                        <img src="~/images/default-user.png" 
                                             width="50" 
                                             height="50" 
                                             class="rounded-circle shadow-sm border" 
                                             alt="Default">
                                    }
                                </td>

                                <!-- NAMA GURU -->
                                <td>
                                    <span class="fw-bold text-dark">
                                        @(item.IdGuruNavigation != null ? item.IdGuruNavigation.NamaGuru : "-")
                                    </span>
                                </td>

                                <!-- TANGGAL -->
                                <td class="text-center text-secondary small">
                                    @item.Tanggal.ToString("dd/MM/yyyy")
                                </td>

                                <!-- JAM MASUK -->
                                <td class="text-center font-monospace small">
                                    @(item.JamMasuk.HasValue ? item.JamMasuk.Value.ToString("HH\\:mm") : "-")
                                </td>

                                <!-- JAM PULANG -->
                                <td class="text-center font-monospace small">
                                    @(item.JamPulang.HasValue ? item.JamPulang.Value.ToString("HH\\:mm") : "-")
                                </td>

                                <!-- LANGKAH 5: STATUS BERWARNA -->
                                <td class="text-center">
                                    @if (item.Status == "Hadir")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill">Hadir</span>
                                    }
                                    else if (item.Status == "Izin")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1.5 text-dark rounded-pill">Izin</span>
                                    }
                                    else if (item.Status == "Sakit")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-1.5 rounded-pill">Sakit</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1.5 rounded-pill">Alpha</span>
                                    }
                                </td>

                                <!-- LANGKAH 6: TOMBOL AKSI (TANPA HAPUS) -->
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.IdAbsensi" class="btn btn-primary btn-sm btn-action d-flex align-items-center justify-content-center style="width: 32px; height: 32px; border-radius: 8px;" title="Lihat Detail">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.IdAbsensi" class="btn btn-warning btn-sm btn-action text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: 8px;" title="Ubah Data">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5 fs-6">
                                <i class="bi bi-calendar-x d-block fs-2 mb-2 text-secondary opacity-50"></i>
                                Belum ada data absensi yang tercatat.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

<!-- LANGKAH 7: SEARCH OTOMATIS (JAVASCRIPT CLIENT-SIDE) -->
@section Scripts {
    <script>
        document.getElementById("searchGuru").addEventListener("keyup", function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll("#tableGuru tr");

            rows.forEach(function (row) {
                // Mengambil kolom ke-3 (indeks 2) yaitu kolom Nama Guru
                let namaCell = row.cells[2];
                if (namaCell) {
                    let nama = namaCell.innerText.toLowerCase();
                    row.style.display = nama.includes(filter) ? "" : "none";
                }
            });
        });
    </script>
}