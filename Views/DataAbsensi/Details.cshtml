@model Absensiguru.Models.Absensi

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Detail Absensi";
}

<div class="card shadow rounded-4 border-0">

    <div class="card-header bg-primary text-white">

        <h3>Detail Absensi</h3>

    </div>

    <div class="card-body">

        <table class="table table-bordered">

            <tr>
                <th width="220">Nama Guru</th>
                <td>@Model.IdGuruNavigation.NamaGuru</td>
            </tr>

            <tr>
                <th>Tanggal</th>
                <td>@Model.Tanggal.ToString("dd/MM/yyyy")</td>
            </tr>

            <tr>
                <th>Jam Masuk</th>
                <td>@Model.JamMasuk</td>
            </tr>

            <tr>
                <th>Jam Pulang</th>
                <td>@Model.JamPulang</td>
            </tr>

            <tr>
                <th>Status</th>
                <td>@Model.Status</td>
            </tr>

            <tr>
                <th>Keterangan</th>
                <td>@Model.Keterangan</td>
            </tr>

        </table>

        <a asp-action="Edit"
           asp-route-id="@Model.IdAbsensi"
           class="btn btn-warning">

            Edit

        </a>

        <a asp-action="Index"
           class="btn btn-secondary">

            Kembali

        </a>

    </div>

</div>