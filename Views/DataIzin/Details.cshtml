@model Absensiguru.Models.Izin

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Detail Izin";
}

<div class="card shadow border-0 rounded-4">

    <div class="card-header bg-primary text-white">
        <h3>Detail Izin</h3>
    </div>

    <div class="card-body">

        <table class="table">

            <tr>
                <th width="200">Guru</th>
                <td>@Model.IdGuruNavigation.NamaGuru</td>
            </tr>

            <tr>
                <th>Tanggal</th>
                <td>@Model.Tanggal.ToString("dd/MM/yyyy")</td>
            </tr>

            <tr>
                <th>Jenis</th>
                <td>@Model.JenisIzin</td>
            </tr>

            <tr>
                <th>Alasan</th>
                <td>@Model.Alasan</td>
            </tr>

            <tr>
                <th>Bukti</th>
                <td>@Model.Bukti</td>
            </tr>

            <tr>
                <th>Status</th>
                <td>@Model.Status</td>
            </tr>

        </table>

        <a asp-action="Edit"
           asp-route-id="@Model.IdIzin"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Kembali
        </a>

    </div>

</div>