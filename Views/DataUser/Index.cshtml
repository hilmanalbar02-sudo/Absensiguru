@model IEnumerable<Absensiguru.Models.User>

@{
    ViewData["Title"] = "Data User";
}

<div class="container py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">

            <h3 class="fw-bold mb-0">
                Data User
            </h3>

            <a asp-action="Create"
               class="btn btn-light rounded-pill">

                <i class="fa-solid fa-plus"></i>

                Tambah User

            </a>

        </div>

        <div class="card-body">

            <form method="get">

                <div class="row mb-3">

                    <div class="col-md-5">

                        <input type="text"
                               name="searchString"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Cari username atau nama guru..." />

                    </div>

                    <div class="col-md-2">

                        <button class="btn btn-danger w-100">

                            Cari

                        </button>

                    </div>

                </div>

            </form>

            <div class="table-responsive">

                <table class="table table-hover table-bordered align-middle">

                    <thead class="table-danger">

                        <tr class="text-center">

                            <th>No</th>
                            <th>Username</th>
                            <th>Nama Guru</th>
                            <th>Role</th>
                            <th width="180">Aksi</th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int no = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="text-center">
                                    @no
                                </td>

                                <td>
                                    @item.Username
                                </td>

                                <td>

                                    @(item.IdGuruNavigation != null
                                        ? item.IdGuruNavigation.NamaGuru
                                        : "-")

                                </td>

                                <td class="text-center">

                                    @if (item.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">
                                            Admin
                                        </span>
                                    }
                                    else if (item.Role == "Guru")
                                    {
                                        <span class="badge bg-primary">
                                            Guru
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            TU
                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <a asp-action="Details"
                                       asp-route-id="@item.IdUser"
                                       class="btn btn-primary btn-sm">

                                        <i class="fa-solid fa-eye"></i>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.IdUser"
                                       class="btn btn-warning btn-sm">

                                        <i class="fa-solid fa-pen"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.IdUser"
                                       class="btn btn-danger btn-sm">

                                        <i class="fa-solid fa-trash"></i>

                                    </a>

                                </td>

                            </tr>

                            no++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>