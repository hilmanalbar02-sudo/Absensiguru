@model Absensiguru.Models.User

@{
    ViewData["Title"] = "Detail User";
}

<div class="container py-4">

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-danger text-white">

            <h3 class="mb-0 fw-bold">
                Detail Data User
            </h3>

        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Nama Guru
                </div>

                <div class="col-md-9">
                    @(Model.IdGuruNavigation != null
                        ? Model.IdGuruNavigation.NamaGuru
                        : "-")
                </div>

            </div>

            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Username
                </div>

                <div class="col-md-9">
                    @Model.Username
                </div>

            </div>

            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Password
                </div>

                <div class="col-md-9">
                    ********
                </div>

            </div>

            <div class="row mb-4">

                <div class="col-md-3 fw-bold">
                    Role
                </div>

                <div class="col-md-9">

                    @if (Model.Role == "Admin")
                    {
                        <span class="badge bg-danger">
                            Admin
                        </span>
                    }
                    else if (Model.Role == "TU")
                    {
                        <span class="badge bg-success">
                            TU
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-primary">
                            Guru
                        </span>
                    }

                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-between">

                <a asp-action="Index"
                   class="btn btn-secondary rounded-pill px-4">

                    ← Kembali

                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.IdUser"
                   class="btn btn-warning rounded-pill px-4">

                    ✏ Edit

                </a>

            </div>

        </div>

    </div>

</div>