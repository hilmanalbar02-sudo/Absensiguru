@model Absensiguru.Models.User

@{
    ViewData["Title"] = "Detail User";
}

<div class="container py-4">
    <div class="card shadow border-0 rounded-4 overflow-hidden">
        
        <!-- HEADER UTAMA -->
        <div class="card-header bg-danger text-white py-3">
            <h4 class="mb-0 fw-bold d-flex align-items-center">
                <i class="bi bi-person-vcard-fill me-2"></i>
                Detail Akun Pengguna
            </h4>
        </div>

        <div class="card-body p-4">
            <div class="row align-items-center">
                
                <!-- BAGIAN FOTO PROFIL (KIRI) -->
                <div class="col-md-4 text-center border-end-md py-3 mb-4 mb-md-0">
                    <div class="position-relative d-inline-block">
                        @if (!string.IsNullOrEmpty(Model.IdGuruNavigation?.Foto))
                        {
                            <img src="~/uploads/guru/@Model.IdGuruNavigation.Foto"
                                 class="rounded-circle shadow-sm border border-4 border-white"
                                 width="170"
                                 height="170"
                                 style="object-fit: cover;"
                                 alt="Foto Profil @Model.Username">
                        }
                        else
                        {
                            <img src="~/images/default-user.png"
                                 class="rounded-circle shadow-sm border border-4 border-white"
                                 width="170"
                                 height="170"
                                 style="object-fit: cover;"
                                 alt="Foto Default">
                        }
                    </div>
                    <h5 class="fw-bold mt-3 mb-1 text-dark">
                        @(Model.IdGuruNavigation != null ? Model.IdGuruNavigation.NamaGuru : "-")
                    </h5>
                    <p class="text-muted small mb-0">
                        NIP: @(Model.IdGuruNavigation != null ? Model.IdGuruNavigation.Nip : "-")
                    </p>
                </div>

                <!-- BAGIAN KETERANGAN AKUN (KANAN) -->
                <div class="col-md-8 ps-md-4">
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle">
                            <tbody>
                                <tr>
                                    <td width="30%" class="text-secondary fw-semibold">Nama Lengkap Guru</td>
                                    <td width="5%" class="text-muted">:</td>
                                    <td class="text-dark fw-medium">
                                        @(Model.IdGuruNavigation != null ? Model.IdGuruNavigation.NamaGuru : "-")
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-secondary fw-semibold">Username Sistem</td>
                                    <td class="text-muted">:</td>
                                    <td class="text-dark font-monospace fw-bold">@Model.Username</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary fw-semibold">Kata Sandi (Password)</td>
                                    <td class="text-muted">:</td>
                                    <td class="text-muted">
                                        <span class="badge bg-light text-secondary border px-3">
                                            <i class="bi bi-lock-fill me-1"></i> ••••••••
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-secondary fw-semibold">Hak Akses / Peran</td>
                                    <td class="text-muted">:</td>
                                    <td>
                                        @if (Model.Role == "Admin")
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-3 py-1 border border-danger-subtle rounded-pill">
                                                Administrator
                                            </span>
                                        }
                                        else if (Model.Role == "TU")
                                        {
                                            <span class="badge bg-primary-subtle text-primary px-3 py-1 border border-primary-subtle rounded-pill">
                                                Tata Usaha
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-1 border border-success-subtle rounded-pill">
                                                Guru
                                            </span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-secondary fw-semibold">Status Akun</td>
                                    <td class="text-muted">:</td>
                                    <td>
                                        <span class="badge bg-success px-2 py-1 small rounded d-inline-flex align-items-center">
                                            <span class="spinner-grow spinner-grow-sm me-1" style="width: 6px; height: 6px; animation-duration: 1.5s;"></span>
                                            Aktif
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <!-- BUTTON NAVIGASI -->
            <hr class="text-muted opacity-25 my-4" />
            
            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 10px; font-weight: 500;">
                    <i class="bi bi-arrow-left me-2"></i>
                    Kembali ke Daftar
                </a>
                
                <a asp-action="Edit" asp-route-id="@Model.IdUser" class="btn btn-warning px-4 py-2 text-dark" style="border-radius: 10px; font-weight: 500;">
                    <i class="bi bi-pencil-square me-2"></i>
                    Ubah Data User
                </a>
            </div>

        </div>
    </div>
</div>
<!-- CARD KECIL: RINGKASAN INFORMASI AKUN -->
<div class="card border-0 shadow-sm rounded-4 bg-light-subtle mb-4">
    <div class="card-body p-3">
        <h6 class="fw-bold text-secondary mb-3 d-flex align-items-center">
            <i class="bi bi-info-circle-fill text-primary me-2"></i>
            Informasi Akun
        </h6>
        
        <div class="row g-2 small">
            <div class="col-6 text-muted">Username</div>
            <div class="col-6 fw-bold text-dark">: @Model.Username</div>
            
            <div class="col-6 text-muted">Role</div>
            <div class="col-6 fw-bold text-dark">: 
                @(Model.Role == "Admin" ? "Administrator" : Model.Role == "TU" ? "Tata Usaha" : "Guru")
            </div>
            
            <div class="col-6 text-muted">Status</div>
            <div class="col-6 fw-bold text-success">: 🟢 Aktif</div>
            
            <div class="col-6 text-muted">Terakhir Login</div>
            <div class="col-6 fw-semibold text-secondary">: @DateTime.Now.ToString("dd MMMM yyyy")</div>
        </div>
    </div>
</div>